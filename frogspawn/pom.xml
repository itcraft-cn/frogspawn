<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.itcraft</groupId>
    <artifactId>frogspawn</artifactId>
    <version>0.7.0</version><!-- managed by updgitver -->

    <name>frogspawn</name>
    <description>A java object pool, focus on gc-friendry/low-latency.</description>
    <url>https://itcraft.cn/frogspawn/</url>

    <scm>
        <connection>scm:git:git://github.com/itcraft-cn/frogspawn.git</connection>
        <developerConnection>scm:git:ssh://github.com/itcraft-cn/frogspawn.git</developerConnection>
        <url>https://github.com/itcraft-cn/frogspawn/</url>
    </scm>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Helly Guo</name>
            <email>hellyguo@foxmail.com</email>
        </developer>
    </developers>

    <dependencies>
        <!-- log -->
        <!-- slf4j -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>1.7.32</version>
        </dependency>
    </dependencies>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!--
            JDK8 用于编译 base 层（src/main/java + src/main/java8）。
            优先使用环境变量 JAVA_HOME8，也可以通过 -Dmr.base.jdk.home=... 覆盖。
            JDK8 is used to compile the base layer (src/main/java + src/main/java8).
            Defaults to the JAVA_HOME8 environment variable and can be overridden
            with -Dmr.base.jdk.home=...
        -->
        <mr.base.jdk.home>${env.JAVA_HOME8}</mr.base.jdk.home>
        <!-- JDK9+ 覆盖层输出目录 / JDK9+ overlay output directory -->
        <mr.java9.output>${project.build.outputDirectory}/META-INF/versions/9</mr.java9.output>
    </properties>

    <build>
        <plugins>
            <!-- compiler: base layer (JDK8) + versioned overlay (JDK9+) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <!-- 公共代码 + JDK8 专有实现 / common code + JDK8-specific implementation -->
                            <compileSourceRoots>
                                <compileSourceRoot>${project.build.sourceDirectory}</compileSourceRoot>
                                <compileSourceRoot>${project.basedir}/src/main/java8</compileSourceRoot>
                            </compileSourceRoots>
                            <source>8</source>
                            <target>8</target>
                            <fork>true</fork>
                            <executable>${mr.base.jdk.home}/bin/javac</executable>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- jar: multi-release packaging -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <excludes>
                        <exclude>META-INF/jpms.args</exclude>
                        <exclude>META-INF/versions/9/META-INF/jpms.args</exclude>
                    </excludes>
                    <archive>
                        <manifestEntries>
                            <Multi-Release>true</Multi-Release>
                            <Automatic-Module-Name>cn.itcraft.frogspawn</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <!-- 将 src/main/java8 注册为源码根，sources jar 才能收录 JDK8 实现 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>add-java8-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/src/main/java8</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- source -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 将 java9 源码映射到 sources jar 的 META-INF/versions/9 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>add-java9-sources</id>
                        <phase>package</phase>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/mr-sources/META-INF/versions/9"/>
                                <copy todir="${project.build.directory}/mr-sources/META-INF/versions/9">
                                    <fileset dir="${project.basedir}/src/main/java9"/>
                                </copy>
                                <mkdir dir="${project.build.directory}/mr-sources/META-INF/versions/24"/>
                                <copy todir="${project.build.directory}/mr-sources/META-INF/versions/24">
                                    <fileset dir="${project.basedir}/src/main/java24"/>
                                </copy>
                                <jar destfile="${project.build.directory}/${project.build.finalName}-sources.jar"
                                     update="true">
                                    <fileset dir="${project.build.directory}/mr-sources"/>
                                </jar>
                            </target>
                        </configuration>
                        <goals>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- javadoc -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <source>8</source>
                    <sourcepath>${project.build.sourceDirectory}${path.separator}${project.basedir}/src/main/java8</sourcepath>
                    <javadocExecutable>${mr.base.jdk.home}/bin/javadoc</javadocExecutable>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- gpg -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-gpg-plugin</artifactId>
                <version>3.2.7</version>
                <executions>
                    <execution>
                        <id>sign-artifacts</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>sign</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- publish -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.12.0</version>
                <extensions>true</extensions>
                <configuration>
                    <publishingServerId>maven-sonatype-central</publishingServerId>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            未设置 JAVA_HOME8 时回退到当前 Maven 使用的 JDK。
            仅当 Maven 本身运行在 JDK8 上时该回退才能编译 base 层。
            Fall back to the JDK running Maven when JAVA_HOME8 is not set.
            The base layer can only be compiled this way on JDK8 itself.
        -->
        <profile>
            <id>base-jdk-fallback</id>
            <activation>
                <property>
                    <name>!env.JAVA_HOME8</name>
                </property>
            </activation>
            <properties>
                <mr.base.jdk.home>${java.home}</mr.base.jdk.home>
            </properties>
        </profile>
        <!--
            JDK9+ 覆盖层：仅在使用 JDK9 及以上构建时编译。
            产物输出到 META-INF/versions/9，由 JVM 在 JDK9+ 上优先加载。
            JDK9+ overlay: compiled only when building with JDK9 or above.
            Output goes to META-INF/versions/9 and is preferred by the JVM on JDK9+.
        -->
        <!--
            JDK24+ 覆盖层：使用 java.lang.foreign.MemorySegment 替代 sun.misc.Unsafe。
            JDK24+ overlay: use java.lang.foreign.MemorySegment instead of sun.misc.Unsafe.
        -->
        <profile>
            <id>mr-java24</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-java24</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java24</compileSourceRoot>
                                    </compileSourceRoots>
                                    <outputDirectory>${project.build.outputDirectory}/META-INF/versions/24</outputDirectory>
                                    <release>24</release>
                                    <compilerArgs>
                                        <arg>-Xlint:-options</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>mr-java9</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-java9</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                                <configuration>
                                    <compileSourceRoots>
                                        <compileSourceRoot>${project.basedir}/src/main/java9</compileSourceRoot>
                                    </compileSourceRoots>
                                    <outputDirectory>${mr.java9.output}</outputDirectory>
                                    <source>9</source>
                                    <target>9</target>
                                    <fork>false</fork>
                                    <compilerArgs>
                                        <arg>--add-exports</arg>
                                        <arg>java.base/jdk.internal.vm.annotation=ALL-UNNAMED</arg>
                                        <arg>-Xlint:-options</arg>
                                    </compilerArgs>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
